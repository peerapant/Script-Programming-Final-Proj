# Service Account Key (JSON format)
GCP_SERVICE_ACCOUNT_KEY="your_service_account_key_json_here"

# Spreadsheet ID for Google Sheets
SPREADSHEET_ID="your_google_sheet_id_here"

# Email Gateway (SMTP Settings)
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Webhook Notification Settings (Discord / Slack)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your/webhook/url"

# Master Encryption Key
MASTER_ENCRYPTION_KEY="your_master_encryption_key_here"

# GitHub Actions On-Demand Trigger (ปุ่ม "เปลี่ยนชื่อตอนนี้")
GITHUB_REPO_OWNER="your_github_username_or_org"
GITHUB_REPO_NAME="your_repository_name"
GITHUB_PAT_TOKEN="your_github_personal_access_token"

GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="your_google_redirect_uri_here"