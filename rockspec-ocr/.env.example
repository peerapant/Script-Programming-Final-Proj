# Service Account Key (JSON format)
GCP_SERVICE_ACCOUNT_KEY="your_service_account_key_json_here"

# Spreadsheet ID for Google Sheets
SPREADSHEET_ID="your_google_sheet_id_here"

# Email Gateway (SMTP Settings)
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Webhook Notification Settings (Discord / Slack)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your/webhook/url"

# Master Encryption Key
MASTER_ENCRYPTION_KEY="your_master_encryption_key_here"